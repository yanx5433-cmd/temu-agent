# ===== 复制为 .env 后填写；所有密钥只放这里，禁止写进代码 =====

# 数据库（本地默认 SQLite；Docker Compose 用 PostgreSQL）
DATABASE_URL=sqlite:///./data/temu_agent.db
# DATABASE_URL=postgresql+psycopg2://temu:temu_dev_password@localhost:5432/temu_agent
POSTGRES_PASSWORD=temu_dev_password
REDIS_URL=redis://localhost:6379/0

# TEMU 接入方式：mock / csv / manual / official
# 未取得 TEMU Partner Platform 授权前保持 mock 或 csv
TEMU_ADAPTER=mock
TEMU_APP_KEY=
TEMU_APP_SECRET=

# LLM（可选）：rule=纯规则离线；openai=OpenAI 兼容接口
LLM_PROVIDER=rule
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# 安全
SECRET_KEY=dev-only-change-me
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_AUTOMATION_LEVEL=L1

# 外部接口保护
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
HTTP_RATE_LIMIT_PER_MIN=30
